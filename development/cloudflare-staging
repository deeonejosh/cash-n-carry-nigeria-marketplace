name: Cash N Carry — Cloudflare staging ONLY

on:
  workflow_dispatch:
    inputs:
      confirm_staging_only:
        description: 'Type DEPLOY_STAGING_ONLY (never deploy production)'
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: cashncarry-cloudflare-staging
  cancel-in-progress: false

jobs:
  deploy_staging:
    if: github.ref_name == 'development/cloudflare-staging' && github.event.inputs.confirm_staging_only == 'DEPLOY_STAGING_ONLY'
    runs-on: ubuntu-latest
    environment: cashncarry-staging
    timeout-minutes: 45
    steps:
      - name: Checkout exact branch
        uses: actions/checkout@v4
        with:
          persist-credentials: false

      - name: Enforce staging branch and known source
        shell: bash
        env:
          REF_NAME: ${{ github.ref_name }}
        run: |
          set -euo pipefail
          case "$REF_NAME" in
            development/cloudflare-staging) ;;
            *) echo 'Ref is not an approved staging branch'; exit 1 ;;
          esac
          test -f scripts/start-hosted-staging.mjs
          test -f prisma/schema.prisma
          test -f Dockerfile
          grep -q 'cashncarryng\.com' scripts/start-hosted-staging.mjs || { echo 'Missing production hostname protection'; exit 1; }
          test "$(find prisma/migrations -name migration.sql | wc -l | tr -d ' ')" = 18

      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm

      - name: Install application dependencies
        run: npm ci

      - name: Unit tests
        run: npm test

      - name: Lint and types
        run: |
          npm run lint
          npm run typecheck

      - name: Verify GitHub and Cloudflare deployment secrets exist
        shell: bash
        env:
          CF_TOKEN: ${{ secrets.CLOUDFLARE_STAGING_API_TOKEN }}
          NEON_URL: ${{ secrets.NEON_STAGING_DIRECT_URL }}
        run: |
          set -euo pipefail
          test -n "$CF_TOKEN" || { echo 'Missing CLOUDFLARE_STAGING_API_TOKEN'; exit 1; }
          test -n "$NEON_URL" || { echo 'Missing NEON_STAGING_DIRECT_URL'; exit 1; }
          case "$NEON_URL" in
            *'/cashncarry_staging'* ) ;;
            *) echo 'Database name mismatch: refusing migrations'; exit 1 ;;
          esac

      - name: Apply staging-only Prisma migrations
        shell: bash
        env:
          DATABASE_URL: ${{ secrets.NEON_STAGING_DIRECT_URL }}
        run: |
          set -euo pipefail
          npx prisma migrate deploy
          npx prisma migrate status

      - name: Docker availability
        run: docker info >/dev/null

      - name: Prepare isolated Docker context
        run: bash scripts/prepare-cloudflare-staging-context.sh

      - name: Install Cloudflare CLI in separate staging project
        working-directory: deploy/cloudflare-staging
        run: npm install --no-audit --no-fund --no-package-lock

      - name: Build and deploy STAGING Worker plus Docker image
        working-directory: deploy/cloudflare-staging
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_STAGING_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: '508a24cccf3f5f764015a27fa1bb0f15'
        run: |
          set -euo pipefail
          npx cf deploy --containers-rollout immediate

      - name: Verify real HTTPS staging health endpoint
        shell: bash
        env:
          STAGE_URL: https://cashncarry-staging-worker.cashncarry-workforce-2026.workers.dev
        run: |
          set -euo pipefail
          for i in $(seq 1 24); do
            if curl -fsS --retry 0 --max-time 15 "$STAGE_URL/api/health" -o /tmp/staging-health.json; then
              node -e "const fs=require('fs');const x=JSON.parse(fs.readFileSync('/tmp/staging-health.json'));if(x.ok!==true||x.db!=='connected')process.exit(1)"
              echo "Staging database-backed HTTPS health succeeded: $STAGE_URL/api/health"
              exit 0
            fi
            sleep 10
          done
          echo 'Cloudflare deployment did not pass public HTTPS health verification'
          exit 1
