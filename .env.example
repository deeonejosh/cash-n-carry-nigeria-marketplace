# Payment integrations are disabled unless real test keys are configured.
# Generate a random secret with: openssl rand -base64 48
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cash_n_carry_dev?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""

# Optional staging-only LiveKit project. Use wss:// on hosted staging.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Direct or session-pooled PostgreSQL URL for LISTEN/NOTIFY.
EVENTS_DATABASE_URL=

# Required for PDF upload and retrieval in a production-mode process.
# Generate a per-environment key using openssl rand -hex 32.
KYC_DOCUMENT_KEY=
# Use a private Unix socket or private network. clamd TCP does not provide TLS.
KYC_CLAMD_SOCKET=
KYC_CLAMD_HOST=
KYC_CLAMD_PORT=3310

# Secret shared with a trusted carrier adapter that signs the normalised tracking events.
CARRIER_WEBHOOK_SECRET=

# Private S3-compatible bucket for encrypted KYC envelopes.
KYC_S3_BUCKET=
KYC_S3_REGION=us-east-1
KYC_S3_ENDPOINT=
KYC_S3_PATH_STYLE=0
# AWS credential provider chain. Set access keys only through the staging secret manager if needed.

# Platform commission in basis points, applied after linked confirmed refunds.
SELLER_COMMISSION_BPS=0
